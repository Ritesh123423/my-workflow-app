DATABASE_URL=postgresql://username:password@localhost:5432/audit_workflow
JWT_SECRET=your-secret-key-here-change-in-production
NODE_ENV=development
PORT=3000

# The public URL of this deployment (no trailing slash).
# Used as the OAuth redirect_uri base. Must match exactly what you register
# in Google Cloud Console / Azure App Registration.
# Example for Render: https://my-workflow-app.onrender.com
APP_URL=https://my-workflow-app.onrender.com

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/  →  APIs & Services  →  Credentials
# 2. Create an OAuth 2.0 Client ID  (Web application)
# 3. Add Authorised redirect URI:  <APP_URL>/api/auth/google/callback
# 4. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (optional) ───────────────────────────────────────────────
# 1. Go to https://portal.azure.com/  →  App registrations  →  New registration
# 2. Add Redirect URI:  <APP_URL>/api/auth/microsoft/callback  (type: Web)
# 3. Under Certificates & secrets, create a new Client secret
# 4. Set MS_TENANT_ID to your tenant ID, or leave as "common" for any Microsoft account
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# Render sets DATABASE_URL + JWT_SECRET automatically via render.yaml
# Master ROU data is stored in rou_* tables (Postgres), scoped per JWT user
